# Database — PostgreSQL (Supabase)
DATABASE_URL="postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres"

# JWT
JWT_SECRET="ganti-dengan-secret-random-yang-panjang"
JWT_EXPIRES_IN="7d"

# Signed streaming URL
STREAM_SECRET="ganti-dengan-secret-random-yang-lain-buat-stream-token"

# Bootstrap admin pertama (sekali pakai, lihat README bagian Admin)
ADMIN_BOOTSTRAP_SECRET="ganti-dengan-secret-random-lainnya"

# Storage lokal (development). Untuk production, ganti implementasi src/lib/storage.ts ke S3/R2.
STORAGE_ROOT="./uploads"

# Server
PORT=8000

# CORS - origin frontend Next.js
CORS_ORIGIN="http://localhost:3000"
